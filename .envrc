# Secret *values* live outside the repo, at ~/.secrets/nba_bets.env (mode 600),
# so they cannot be `git add`ed by accident. This file only wires them up and is
# safe to commit. `_if_exists` keeps `cd` from erroring on a fresh clone.
dotenv_if_exists ~/.secrets/nba_bets.env

# uv-managed venv, activated on cd
export VIRTUAL_ENV="$PWD/.venv"
export VIRTUAL_ENV_PROMPT="(nba_bets)"
PATH_add "$VIRTUAL_ENV/bin"
